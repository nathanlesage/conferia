{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "allowJs": true,
    "sourceMap": true,
    "strict": true,  
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "dist",
    "types": ["node", "mocha"]
  },
  "include": [
    "./src/**/*.ts",
    "./test/**/*.spec.ts"
  ]
}
